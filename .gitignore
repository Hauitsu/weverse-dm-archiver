# work output / large files
# everything under media/ is downloaded work output, except the emoji font: the generated page
# references fonts/ and the archive is meant to look the same on every machine, so that one
# directory ships with the repo: Noto as fallback plus the Apple cut (~5 MB).
media/*
!media/fonts/
downloads/
rooms/
dist/
share/
*.zip
*.log

# secrets / local machine
.env
.env.*
config.json
profile/
node_modules/

# OS
Thumbs.db
desktop.ini
.DS_Store
verify/
rooms-public/
# the artist pictures ship with the repo (small); the full-size originals in media/avatar-src/ stay local
!media/avatars/
!media/avatars/*-artist.png
!media/avatars/*-artist.jpg
!media/avatars/*-artist.jpeg
!media/avatars/*-artist.webp
